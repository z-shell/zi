{
  "name": "zsh-pyenv",
  "description": "Simple Python version management",
  "author": "Yuu Yamashita, Sam Stephenson, Mislav Marohnić, Josh Friend",
  "homepage": "https://github.com/pyenv/pyenv",
  "bugs": {
    "url": "https://github.com/pyenv/pyenv/issues"
  },
  "license": "MIT",
  "keywords": ["version management", "python version management", "zsh"],
  "zsh-data": {
    "plugin-info": {
      "user": "pyenv",
      "plugin": "pyenv",
      "requires": "bash"
    },
    "zi-ices": {
      "default": {
        "git": "",
        "depth": "1",
        "lucid": "",
        "as": "program",
        "pick": "bin/pyenv",
        "atinit": "export PYENV_ROOT=\"${PYENV_ROOT:-$HOME/.pyenv}\"",
        "nocompile": "!",
        "atload": "local pyenv_init; pyenv_init=$(\"$PWD/bin/pyenv\" init - zsh) && eval \"$pyenv_init\" && rehash"
      },
      "bgn": {
        "requires": "bgn",
        "git": "",
        "lucid": "",
        "as": "null",
        "atinit": "export PYENV_ROOT=\"${PYENV_ROOT:-$HOME/.pyenv}\"",
        "nocompile": "!",
        "sbin": "bin/pyenv",
        "atload": "local pyenv_init; pyenv_init=$(\"$PWD/bin/pyenv\" init - zsh) && eval \"$pyenv_init\" && rehash"
      }
    }
  }
}
